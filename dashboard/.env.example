# Point the dashboard at your n8n webhook base (leave empty to use same-origin /webhook)
VITE_API_WEBHOOK_HOST=http://localhost:5678/webhook/api/v1
VITE_API_LIST_FILES_PATH=/list-files
VITE_API_GET_FILE_PATH=/get-file
VITE_API_DOWNLOAD_PATH=/download-file
VITE_API_REFRESH_PATH=/refresh
# Set to true to run on bundled sample data
VITE_DEMO=false
